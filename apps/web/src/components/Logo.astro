---
// The Lacuna mark used in the app's sidebar: three tiles and a lens.
interface Props {
  size?: number;
}
const { size = 22 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
  <rect x="2" y="2" width="9" height="9" rx="2.6" fill="currentColor"></rect>
  <rect x="13" y="2" width="9" height="9" rx="2.6" fill="currentColor" opacity=".55"></rect>
  <rect x="2" y="13" width="9" height="9" rx="2.6" fill="currentColor" opacity=".55"></rect>
  <circle cx="16.6" cy="16.6" r="3.5" fill="none" stroke="currentColor" stroke-width="2.4"></circle>
  <path d="M19.3 19.3l2.4 2.4" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
</svg>
