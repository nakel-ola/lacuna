---
import Icon from './Icon.astro';

// Bar heights for the mini "Space by folder" chart (share of the largest folder).
const BARS = [100, 59, 35, 20, 12, 7, 4, 2.5, 1.5, 1];
const TYPES = [
  { name: 'Developer', share: 38, shade: 'var(--g0)' },
  { name: 'Apps', share: 25, shade: 'var(--g1)' },
  { name: 'Video', share: 17, shade: 'var(--g2)' },
  { name: 'Photos', share: 12, shade: 'var(--g3)' },
  { name: 'Other', share: 8, shade: 'var(--g4)' },
];
const LARGE = [
  { name: 'Xcode_16.xip', where: 'Downloads', size: '11.2 GB' },
  { name: 'Ubuntu-24.04.iso', where: 'Downloads/VMs', size: '6.1 GB' },
  { name: 'Screen Recording.mov', where: 'Desktop', size: '3.4 GB' },
];
---

<section class="section" id="features" aria-labelledby="features-title">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Features</p>
      <h2 id="features-title">Everything you need to get your space back.</h2>
      <p>One scan answers the question every Mac owner eventually asks: <em>where did all my storage go?</em></p>
    </header>

    <div class="bento">
      <article class="card card-wide">
        <div class="card-copy">
          <span class="card-icon"><Icon name="bars" /></span>
          <h3>Space by folder</h3>
          <p>See which folders take the most space at a glance. Click a bar to open that folder; the chart and table follow you down.</p>
        </div>
        <div class="mini-bars" aria-hidden="true">
          {BARS.map((h, i) => <span class:list={{ on: i === 0 }} style={`height:${Math.max(h, 2)}%`} />)}
        </div>
      </article>

      <article class="card">
        <div class="card-copy">
          <span class="card-icon"><Icon name="file" /></span>
          <h3>Find the big files</h3>
          <p>The 200 largest files under any folder, biggest first.</p>
        </div>
        <ul class="mini-list" aria-hidden="true">
          {LARGE.map((f) => (
            <li>
              <span><b>{f.name}</b><small>{f.where}</small></span>
              <em>{f.size}</em>
            </li>
          ))}
        </ul>
      </article>

      <article class="card">
        <div class="card-copy">
          <span class="card-icon"><Icon name="layers" /></span>
          <h3>Know what kind of space</h3>
          <p>Apps, developer files, video, photos, audio and documents. <code>node_modules</code> and <code>.git</code> count as Developer.</p>
        </div>
        <div class="mini-types" aria-hidden="true">
          <div class="type-bar">{TYPES.map((t) => <span style={`flex:${t.share};background:${t.shade}`} />)}</div>
          <ul>{TYPES.slice(0, 3).map((t) => <li><i style={`background:${t.shade}`} />{t.name}</li>)}</ul>
        </div>
      </article>

      <article class="card">
        <div class="card-copy">
          <span class="card-icon"><Icon name="search" /></span>
          <h3>Search everything</h3>
          <p>Find any file or folder by name across the whole scan, largest first.</p>
        </div>
        <div class="mini-search" aria-hidden="true">
          <Icon name="search" size={16} />
          <span>DerivedData</span>
          <kbd>⌘F</kbd>
        </div>
      </article>

      <article class="card">
        <div class="card-copy">
          <span class="card-icon"><Icon name="lock" /></span>
          <h3>Private by design</h3>
          <p>No network access, no account, no analytics. Your file list never leaves your Mac.</p>
        </div>
        <div class="mini-private" aria-hidden="true">
          <span>Network requests</span><b>0</b>
        </div>
      </article>

      <article class="card card-wide card-sage">
        <div class="card-copy">
          <span class="card-icon"><Icon name="restore" /></span>
          <h3>Clean up without the fear</h3>
          <p>
            Collect folders and files with <b>+</b> or drag them onto the Cleanup card. Before anything moves you see every
            path and the total. Everything goes to the Trash, so you can always put it back.
          </p>
        </div>
        <div class="mini-dialog" aria-hidden="true">
          <b>Move to Trash?</b>
          <small>2 items totalling 390 GB will be moved to the Trash.</small>
          <ul>
            <li><code>~/Library/Developer/Xcode/DerivedData</code><span>212 GB</span></li>
            <li><code>~/Downloads/VMs</code><span>178 GB</span></li>
          </ul>
          <div class="mini-dialog-actions"><span>Cancel</span><span class="ink">Move to Trash</span></div>
        </div>
      </article>

      <article class="card">
        <div class="card-copy">
          <span class="card-icon"><Icon name="zap" /></span>
          <h3>Seriously fast</h3>
          <p>A Rust scanner reads whole folders per system call across 16 threads. Millions of files in seconds.</p>
        </div>
        <div class="mini-progress" aria-hidden="true">
          <span class="spin"></span>
          <span>Scanning · 6,224,272 files · 32.0s</span>
        </div>
      </article>

      <article class="card card-wide card-full">
        <div class="card-copy">
          <span class="card-icon"><Icon name="moon" /></span>
          <h3>Feels at home on your Mac</h3>
          <p>A native window with a clean custom title bar, light and dark themes that follow your system, and keyboard shortcuts for everything.</p>
        </div>
        <div class="mini-keys" aria-hidden="true">
          <span><kbd>⌘</kbd><kbd>O</kbd> Scan folder</span>
          <span><kbd>⌘</kbd><kbd>F</kbd> Search</span>
          <span><kbd>⌘</kbd><kbd>R</kbd> Rescan</span>
          <span><kbd>⌘</kbd><kbd>↑</kbd> Up a folder</span>
        </div>
      </article>
    </div>
  </div>
</section>
